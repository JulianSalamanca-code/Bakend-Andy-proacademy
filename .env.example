# Credenciales de Supabase — plantilla.
# Copia este archivo como .env o rellena src/AndyProAcademy.Api/appsettings.Development.json
# NUNCA subas la contraseña real a git.

# Conexión a Postgres (valores de Supabase → Project Settings → Database → Connection string → .NET)
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=

# Supabase Auth — para validar los JWT que emite el login del frontend
# Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# URL del proyecto (pública, va en el frontend)
SUPABASE_PROJECT_URL=https://xxxxxxxxxxxx.supabase.co

# Mercado Pago — credenciales de SANDBOX para el prototipo
# https://www.mercadopago.com.mx/developers/panel/app
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=