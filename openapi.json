{
  "openapi": "3.0.4",
  "info": {
    "title": "Andy Pro Academy API",
    "description": "API de reservaciones y tienda para Andy Cosmetología • Puebla Studio. Este documento OpenAPI es la fuente de la que el frontend Angular genera sus tipos.",
    "version": "v1"
  },
  "paths": {
    "/api/catalog/services": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Lista los servicios publicados con sus complementos",
        "operationId": "GetServices",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceWithAddOnsDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/services/{slug}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Detalle de un servicio",
        "operationId": "GetServiceBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceWithAddOnsDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/catalog/courses": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Lista los cursos publicados",
        "operationId": "GetCourses",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CourseDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/courses/{slug}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Detalle de un curso con temario completo",
        "operationId": "GetCourseBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/catalog/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Lista los productos, opcionalmente por categoría",
        "operationId": "GetProducts",
