    "/api/catalog/specialists": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Especialistas activos",
        "operationId": "GetSpecialists",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpecialistDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/home": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Todo lo que la página de inicio necesita en una llamada",
        "operationId": "GetHomeData",
        "responses": {
          "200": {
            "description": "OK",
