    },
    "/api/diagnostics/database": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Informe del estado del esquema y la seguridad",
        "operationId": "DiagnosticsDatabase",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/diagnostics/migrate": {
      "post": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Aplica las migraciones pendientes",
        "operationId": "RunMigrations",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/diagnostics/reset": {
      "post": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Borra el esquema public (destructivo)",
        "operationId": "ResetDatabase",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/diagnostics/booking-tests": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Prueba disponibilidad, zona horaria y solapamientos",
